---
import '../assets/tailwind.css';

interface Props {
  title?: string;
}

const { title = 'Market Zelle | Envíos a Cuba - Camagüey' } = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Market Zelle - Compra productos y envíalos a tus familiares en Cuba, Camagüey. Alimentos, electrónicos, aseo y más." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
		<title>{title}</title>
		<!-- Script de Netlify Identity para habilitar el panel de administración -->
		<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
	</head>
	<body class="font-['Inter',sans-serif] bg-gray-50 text-gray-800 antialiased">
		<slot />
	</body>
</html>
